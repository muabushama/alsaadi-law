# Local / Hostinger file DB (works without installing MySQL):
DATABASE_URL="file:./dev.db"
# Hostinger MySQL (change prisma provider to mysql first):
# DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
# Optional hashed password (preferred in production):
# ADMIN_PASSWORD_HASH="$2a$12$..."
UPLOAD_DIR="./uploads"
# Optional public contact — leave empty to hide phone/WhatsApp buttons
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PHONE=""
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_EMAIL=""
