# Local Docker MySQL (docker compose up -d):
# DATABASE_URL="mysql://alsaadi:alsaadi@127.0.0.1:3306/alsaadi"
# Hostinger MySQL — from the app use 127.0.0.1 (not srvXXXX.hstgr.io):
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
# Optional hashed password (preferred in production):
# ADMIN_PASSWORD_HASH="$2a$12$..."
UPLOAD_DIR="./uploads"
NEXT_PUBLIC_SITE_URL="https://reem-alsaadi.com"
NEXT_PUBLIC_PHONE=""
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_EMAIL=""
